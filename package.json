{
  "name": "cleanair-local-sentinel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "dist-server/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "dev:stack": "node scripts/dev-stack.mjs",
    "verify:dev-stack": "node scripts/verify-dev-stack.mjs",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "demo": "tsx server/index.ts",
    "smoke:test": "node scripts/smoke-test.mjs",
    "test:aqi": "node scripts/test-aqi.mjs",
    "test:aqi-primitives": "tsx scripts/test-aqi-primitives.ts",
    "test:air-display": "tsx scripts/test-air-quality-display.ts",
    "test:air-map": "node scripts/test-air-map-layout.mjs",
    "test:air-data": "tsx scripts/test-air-data-truth.ts",
    "test:current-aqi": "tsx scripts/test-current-aqi.ts",
    "test:i18n": "node scripts/check-i18n-keys.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "test:capture-validation": "tsx scripts/test-capture-validation.ts",
    "test:report-serializers": "tsx scripts/test-report-serializers.ts",
    "test:recurring-hotspots": "tsx scripts/test-recurring-hotspot.ts",
    "test:sensitive-locations": "tsx scripts/test-sensitive-locations.ts",
    "test:contextual-priority": "tsx scripts/test-contextual-priority.ts",
    "test:context-aware": "tsx scripts/test-recurring-hotspot.ts && tsx scripts/test-sensitive-locations.ts && tsx scripts/test-contextual-priority.ts",
    "test:brics-aqi": "tsx scripts/test-openaq-brics.ts",
    "test:brics-federation": "tsx scripts/test-brics-federation.ts",
    "test:meteorology": "tsx scripts/test-meteorology.ts",
    "test:propagation": "tsx scripts/test-propagation.ts",
    "test:corridors": "tsx scripts/test-corridors.ts",
    "test:regulatory": "tsx scripts/test-regulatory.ts",
    "test:federation-e2e": "tsx scripts/test-federation-e2e.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:a11y:headed": "playwright test tests/accessibility.spec.ts --headed",
    "test:sentinel-auth": "tsx scripts/test-sentinel-auth.ts",
    "test:sentinel-config": "tsx scripts/test-sentinel-config.ts",
    "test:sentinel-catalog": "tsx scripts/test-sentinel-catalog.ts",
    "test:sentinel-process": "tsx scripts/test-sentinel-process.ts",
    "test:sentinel-stats": "tsx scripts/test-sentinel-stats.ts",
    "test:sentinel-gemini": "tsx scripts/test-sentinel-gemini.ts",
    "test:rewards": "tsx scripts/test-rewards.ts",
    "test:sentinel-assessment": "tsx scripts/test-sentinel-assessment.ts",
    "test:sentinel-queue": "tsx scripts/test-sentinel-queue.ts",
    "test:sentinel-media": "tsx scripts/test-sentinel-media.ts",
    "test:sentinel-reprocessing": "tsx scripts/test-sentinel-reprocessing.ts",
    "reprocess:sentinel": "tsx scripts/reprocess-sentinel-reports.ts",
    "verify:sentinel-live": "tsx scripts/verify-sentinel-live.ts",
    "verify:sentinel-e2e": "tsx scripts/verify-sentinel-e2e.ts",
    "verify:air-display": "node scripts/verify-air-quality-display.mjs",
    "verify:air-national": "node scripts/audit-national-air-data.mjs",
    "verify:current-aqi": "node scripts/verify-current-aqi.mjs",
    "test:openaq-key": "node scripts/test-openaq-key.mjs",
    "test:openaq-auth": "tsx scripts/test-openaq-auth.ts",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@google/earthengine": "^1.7.40",
    "@google/genai": "1.9.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.0.0",
    "i18next": "^26.3.5",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-leaflet": "^5.0.0",
    "serverless-http": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
