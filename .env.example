# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_MAP_PROVIDER=leaflet
VITE_GOOGLE_MAPS_BROWSER_KEY=YOUR_GOOGLE_MAPS_KEY_HERE
VITE_API_BASE_URL=/api

# Firebase Web SDK (Frontend)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ENABLE_FIREBASE_ANALYTICS=false
VITE_ENABLE_APP_CHECK=false
VITE_ENABLE_REMOTE_CONFIG=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# ── Backend ────────────────────────────────────────────────────────────────────
# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_THINKING_BUDGET=0
DEBUG_GEMINI_ROUTE=false

# External APIs
DATA_GOV_API_KEY=YOUR_DATA_GOV_KEY_HERE
GOOGLE_SERVER_API_KEY=YOUR_GOOGLE_SERVER_API_KEY_HERE
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_PAGE_LIMIT=1000
CPCB_HARD_MAX_PAGES=1000
CPCB_CACHE_TTL_MINUTES=60
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY_HERE
GOOGLE_CLOUD_PROJECT=cleanair-sentinel-506017
EARTH_ENGINE_PROJECT=cleanair-sentinel-506017
# Optional unattended Earth Engine auth. Keep credentials out of Git.
EARTH_ENGINE_PRIVATE_KEY_FILE=
EARTH_ENGINE_PRIVATE_KEY_JSON=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_LOCATION_CACHE_TTL_MINUTES=1440
OPENAQ_LATEST_CACHE_TTL_MINUTES=10
OPENAQ_HISTORY_CACHE_TTL_MINUTES=60
OPENAQ_SYNC_CONCURRENCY=3
OPENAQ_LOCATION_PAGE_LIMIT=100
AQI_CURRENT_CACHE_TTL_MINUTES=10
AQI_FORECAST_CACHE_TTL_MINUTES=30
AQI_SEARCH_RADIUS_KM=25
AQI_FRESH_HOURS=3
AQI_USABLE_HOURS=12
AQI_MAX_AGE_HOURS=24
AQI_HISTORY_DAYS=7
AQI_FORECAST_MIN_HISTORY_HOURS=72
AQI_MIN_COVERAGE_PERCENT=75

# Public camera-capture validation
CAPTURE_GPS_PREFERRED_ACCURACY_METERS=50
CAPTURE_GPS_MAX_ACCURACY_METERS=150
CAPTURE_GPS_MAX_AGE_SECONDS=30
CAPTURE_MAX_CLOCK_SKEW_SECONDS=300
CAPTURE_MAX_PHOTO_AGE_SECONDS=86400

# Bounded current-AQI history synchronizer
CURRENT_AQI_SYNC_CONCURRENCY=2
CURRENT_AQI_CACHE_TTL_MINUTES=30
CURRENT_AQI_HISTORY_DAYS=2
CURRENT_AQI_REFRESH_BATCH_SIZE=20
CURRENT_AQI_MAX_REQUESTS_PER_RUN=100
CURRENT_AQI_MAX_AGE_HOURS=12

# Sentinel provider (backend-only; choose one provider and keep credentials local)
# CDSE OAuth clients must use cdse endpoints. Commercial Sentinel Hub clients must use commercial endpoints.
SENTINEL_HUB_PROVIDER=cdse
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
ENABLE_SENTINEL_HUB_VERIFICATION=false
# CDSE preset
SENTINEL_HUB_BASE_URL=https://sh.dataspace.copernicus.eu
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# Commercial preset (replace both CDSE endpoint values with these when SENTINEL_HUB_PROVIDER=commercial; never set both pairs)
# SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
# SENTINEL_HUB_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
# Custom provider requires both endpoint URLs. Restart the backend after changing .env.
SENTINEL_HUB_REQUEST_TIMEOUT_MS=30000
SENTINEL_HUB_MAX_ATTEMPTS=3
SENTINEL_HUB_AUTH_FAILURE_COOLDOWN_MINUTES=15
SENTINEL_HUB_VERIFY_CONCURRENCY=1
SENTINEL_HUB_DEFAULT_AOI_RADIUS_METERS=500
SENTINEL_HUB_MAX_AOI_RADIUS_METERS=1500
SENTINEL_HUB_MAX_TILE_CLOUD_COVER=60
SENTINEL_HUB_MAX_LOCAL_CLOUD_PERCENT=35
SENTINEL_HUB_MIN_VALID_PIXEL_PERCENT=60
SENTINEL_HUB_NEAR_WINDOW_DAYS=3
SENTINEL_HUB_BASELINE_LOOKBACK_DAYS=45
SENTINEL_HUB_FOLLOWUP_DAYS=14
SENTINEL_HUB_MAX_CATALOG_PAGES=10
SENTINEL_HUB_MAX_CANDIDATES=40
SENTINEL_HUB_CACHE_TTL_MINUTES=1440
ENABLE_SENTINEL_DEBUG_ROUTES=false

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Optional forecast service
MODEL_FORECAST_API_URL=http://localhost:9000
ENABLE_FORECAST=true

# Express Server Configuration
PORT=8787
API_RATE_LIMIT_PER_HOUR=500
REPORT_RATE_LIMIT_PER_HOUR=60
AI_RATE_LIMIT_PER_HOUR=30
VITE_ENABLE_DEMO_RESOLUTION_DATA=true
ENABLE_DEMO_RESOLUTION_DATA=true
VITE_DEMO_BROWSER_STORAGE=true
